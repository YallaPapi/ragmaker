{
  "name": "ragmaker-desktop",
  "version": "1.0.0",
  "description": "RAGMaker Standalone Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "test": "cd tests && npm test",
    "postinstall": "cd backend && npm install && cd ../frontend && npm install && cd ../tests && npm install"
  },
  "keywords": [
    "rag",
    "ai",
    "desktop",
    "electron",
    "youtube",
    "vector-search"
  ],
  "author": "RAGMaker Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.13.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.0",
    "http-proxy-middleware": "^3.0.5",
    "ws": "^8.14.0"
  },
  "build": {
    "appId": "com.ragmaker.desktop",
    "productName": "RAGMaker Desktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "backend/**/*",
      "frontend/**/*",
      "database/**/*",
      "services/**/*",
      "!backend/node_modules",
      "!frontend/node_modules"
    ],
    "win": {
      "target": "nsis",
      "icon": "frontend/assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "frontend/assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "frontend/assets/icon.png"
    }
  }
}
