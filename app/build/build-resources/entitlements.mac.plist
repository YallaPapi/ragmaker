<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Network access for API calls and updates -->
  <key>com.apple.security.network.client</key>
  <true/>
  
  <!-- Network server for local backend -->
  <key>com.apple.security.network.server</key>
  <true/>
  
  <!-- File system access for documents -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
  
  <!-- Downloads folder access -->
  <key>com.apple.security.files.downloads.read-write</key>
  <true/>
  
  <!-- Documents folder access -->
  <key>com.apple.security.files.documents.read-write</key>
  <true/>
  
  <!-- Camera access for document scanning -->
  <key>com.apple.security.device.camera</key>
  <true/>
  
  <!-- Microphone access for voice input -->
  <key>com.apple.security.device.microphone</key>
  <true/>
  
  <!-- USB access for external devices -->
  <key>com.apple.security.device.usb</key>
  <true/>
  
  <!-- Allow unsigned executable memory (for AI models) -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  
  <!-- Allow JIT compilation (for AI/ML libraries) -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  
  <!-- Allow dyld environment variables -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  
  <!-- Disable library validation for AI libraries -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  
  <!-- Hardware acceleration access -->
  <key>com.apple.security.device.gpu</key>
  <true/>
  
  <!-- Audio input/output -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  
  <!-- Temporary exception for transition period -->
  <key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
  <array>
    <string>com.apple.distributed_notifications.2</string>
    <string>com.apple.metadata.mds.2</string>
  </array>
  
  <!-- Exception for subprocess launching -->
  <key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
  <array>
    <string>com.apple.coreservices.launchservicesd</string>
    <string>com.apple.distributed_notifications</string>
    <string>com.apple.finder</string>
    <string>com.apple.metadata.mds</string>
    <string>com.apple.systemuiserver.spotlight</string>
  </array>
</dict>
</plist>
