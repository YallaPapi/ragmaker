{
  "name": "ragmaker",
  "version": "1.0.0",
  "description": "A YouTube RAG (Retrieval-Augmented Generation) system for indexing and querying video transcripts",
  "main": "src/api/server.js",
  "scripts": {
    "start": "node src/api/server.js",
    "start:refactored": "node src/api/server_refactored.js",
    "start:port": "cross-env PORT=3011 node src/api/server.js",
    "dev": "NODE_ENV=development node src/api/server.js",
    "dev:refactored": "NODE_ENV=development node src/api/server_refactored.js",
    "electron": "cd desktop && npm start",
    "electron:dev": "cd desktop && npm run dev",
    "electron:build": "cd desktop && npm run build",
    "electron:install": "cd desktop && npm install",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:manual": "jest tests/manual --testPathIgnorePatterns=[]",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false --passWithNoTests",
    "test:verbose": "jest --verbose",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand --no-cache",
    "lint": "echo 'TODO: Add ESLint configuration'",
    "lint:fix": "echo 'TODO: Add ESLint fix command'",
    "clean": "rm -rf node_modules && npm install",
    "clean:logs": "rm -rf data/indexing_logs.json",
    "clean:data": "rm -rf data/*.json"
  },
  "keywords": ["youtube", "rag", "ai", "transcripts", "vector-search", "openai", "upstash"],
  "author": "RAGMaker Team",
  "license": "ISC",
  "dependencies": {
    "@langchain/community": "^0.3.51",
    "@langchain/core": "^0.3.71",
    "@langchain/openai": "^0.6.7",
    "@upstash/redis": "^1.35.3",
    "@upstash/vector": "^1.2.2",
    "axios": "^1.11.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^11.5.0",
    "bottleneck": "^2.19.5",
    "cors": "^2.8.5",
    "dotenv": "16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "langchain": "^0.3.30",
    "mongodb": "^6.18.0",
    "openai": "^5.12.2",
    "pg": "^8.16.3",
    "youtube-transcript": "^1.2.1",
    "youtubei.js": "^15.0.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "claude-flow": "^2.0.0-alpha.91",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "jsdom": "^26.1.0",
    "node-fetch": "^3.3.2",
    "supertest": "^6.3.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "overrides": {},
  "resolutions": {}
}
