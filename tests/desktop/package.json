{
  "name": "electron-testing-suite",
  "version": "1.0.0",
  "description": "Comprehensive testing suite for Electron desktop application",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:e2e": "jest tests/e2e",
    "test:performance": "jest tests/performance",
    "test:platform": "jest tests/platform",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand --no-cache",
    "build": "electron-builder",
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.8.1",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "spectron": "^19.0.0",
    "@testing-library/dom": "^9.3.4",
    "@testing-library/user-event": "^14.5.1",
    "puppeteer": "^21.6.0",
    "playwright-electron": "^0.4.0",
    "electron-mock-ipc": "^0.3.12",
    "cross-env": "^7.0.3",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.ragmaker.desktop",
    "productName": "RAG Maker Desktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}