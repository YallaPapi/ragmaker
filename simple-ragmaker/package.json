{
  "name": "simple-ragmaker",
  "version": "1.0.0",
  "description": "Simple RAG Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "dev": "electron . --dev"
  },
  "keywords": ["electron", "rag", "ai", "chat"],
  "author": "RAGMaker Team",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4"
  },
  "build": {
    "appId": "com.ragmaker.simple",
    "productName": "Simple RAGMaker",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "src/**/*"
    ],
    "win": {
      "target": "dir"
    },
    "compression": "store"
  }
}