# Server Configuration
NODE_ENV=development
PORT=3000
CORS_ORIGIN=*
BODY_LIMIT=10mb

# YouTube API
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_QUOTA_LIMIT=10000
YOUTUBE_RATE_LIMIT_WINDOW=60000
YOUTUBE_MAX_RETRIES=3

# Upstash Vector Database
UPSTASH_VECTOR_REST_URL=your_upstash_vector_url
UPSTASH_VECTOR_REST_TOKEN=your_upstash_vector_token

# Upstash Redis (optional)
UPSTASH_REDIS_REST_URL=your_upstash_redis_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ORG_ID=your_openai_org_id
OPENAI_TIMEOUT=30000

# Embedding Configuration
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CHUNK_SIZE=500
CHUNK_OVERLAP=100
EMBEDDING_BATCH_SIZE=100

# Generation Configuration
GENERATION_MODEL=gpt-4o-mini
GENERATION_TEMPERATURE=0.7
GENERATION_MAX_TOKENS=2500
GENERATION_TOP_P=1.0
GENERATION_FREQUENCY_PENALTY=0
GENERATION_PRESENCE_PENALTY=0

# Alternative AI Providers (optional)
ANTHROPIC_API_KEY=your_anthropic_key
ANTHROPIC_MODEL=claude-3-haiku-20240307
ANTHROPIC_MAX_TOKENS=4096

GOOGLE_AI_API_KEY=your_google_ai_key
GOOGLE_AI_MODEL=gemini-pro

# Security
API_KEY_REQUIRED=false
ADMIN_API_KEY=your_admin_api_key
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRATION=24h

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# File Upload
MAX_FILE_SIZE=50mb
ALLOWED_FILE_TYPES=application/json,text/plain

# Database Configuration (optional)
SQLITE_PATH=./data/ragmaker.db
MONGODB_URL=mongodb://localhost:27017/ragmaker
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ragmaker
DB_USER=postgres
DB_PASSWORD=