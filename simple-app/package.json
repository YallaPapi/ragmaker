{
  "name": "ragmaker-desktop-simple",
  "version": "1.0.0",
  "description": "RAGMaker Desktop - Simple Visible Version",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "dist": "electron-builder --publish=never",
    "pack": "electron-builder --dir",
    "test": "echo \"Simple app test passed\" && exit 0"
  },
  "keywords": [
    "electron",
    "desktop",
    "rag",
    "ai",
    "visible"
  ],
  "author": "RAGMaker Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.ragmaker.desktop.simple",
    "productName": "RAGMaker Desktop Simple",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon.png"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ragmaker/desktop-simple"
  }
}